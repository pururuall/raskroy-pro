{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Раскрой Про",
  "version": "0.4.0",
  "identifier": "ru.mobil66.raskroy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Раскрой Про — Оптимизация линейного раскроя (АО «Мобиль»)",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "АО «Мобиль»",
    "copyright": "© 2026 АО «Мобиль» (mobil66.ru)",
    "shortDescription": "Оптимизация линейного раскроя профилей",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
